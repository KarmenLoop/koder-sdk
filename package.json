{
  "name": "koder-sdk",
  "version": "0.1.0",
  "description": "Call Koder from TypeScript, JavaScript or Python. The KARMEN LOOP kernel is not in this repository.",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.mjs",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./dist/index.mjs"
    },
    "./server": "./dist/server.mjs"
  },
  "bin": {
    "koder-sdk-server": "bin/koder-sdk-server.mjs"
  },
  "files": ["bin", "dist", "src", "index.d.ts", "README.md"],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node scripts/build.mjs && node --test --test-timeout=60000 test/*.test.mjs",
    "test:python": "node scripts/build.mjs && cd python && python3 -m unittest discover -s tests -v",
    "typecheck": "tsc -p ."
  }
}
